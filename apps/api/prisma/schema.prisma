// Prisma Schema for ParkEase Smart Parking Booking Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  avatar        String?
  role          String         @default("CUSTOMER") // CUSTOMER, OWNER, ADMIN
  isVerified    Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  vehicles      Vehicle[]
  parkingOwner  ParkingOwner?
  bookings      Booking[]
  slotHolds     SlotHold[]
  couponUsages  CouponUsage[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  supportTickets SupportTicket[]
  auditLogs     AuditLog[]
}

model Vehicle {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleNumber String
  vehicleType   String    @default("FOUR_WHEELER") // FOUR_WHEELER, TWO_WHEELER, EV, ACCESSIBLE
  brand         String?
  model         String?
  color         String?
  isEv          Boolean   @default(false)
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]
}

model ParkingOwner {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName      String
  gstin             String?
  isVerified        Boolean         @default(true)
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  totalEarnings     Float           @default(0.0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  facilities        ParkingFacility[]
  payouts           Payout[]
}

model ParkingFacility {
  id            String            @id @default(uuid())
  ownerId       String
  owner         ParkingOwner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  address       String
  city          String
  state         String            @default("Karnataka")
  zipCode       String?
  latitude      Float
  longitude     Float
  phone         String?
  email         String?
  openingTime   String            @default("06:00 AM")
  closingTime   String            @default("11:00 PM")
  is247         Boolean           @default(true)
  status        String            @default("APPROVED") // PENDING, APPROVED, REJECTED, SUSPENDED
  rules         String?
  photos        String            @default("[]") // JSON string of photo URLs
  totalSlots    Int               @default(0)
  featured      Boolean           @default(false)
  rating        Float             @default(4.8)
  reviewCount   Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  slots         ParkingSlot[]
  amenities     FacilityAmenity[]
  pricing       ParkingPricing?
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
}

model FacilityAmenity {
  id          String          @id @default(uuid())
  facilityId  String
  facility    ParkingFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  amenity     String          // CCTV, Security, Covered, EV_CHARGING, Valet, Restroom, Car_wash, Accessible

  @@unique([facilityId, amenity])
}

model ParkingPricing {
  id                    String          @id @default(uuid())
  facilityId            String          @unique
  facility              ParkingFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  hourlyRate            Float           @default(40.0)
  dailyMaxRate          Float           @default(300.0)
  weekendSurgePercent   Float           @default(15.0)
  peakHourMultiplier    Float           @default(1.2)
  evChargeRate          Float           @default(25.0)
  platformFeePercent    Float           @default(10.0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model ParkingSlot {
  id            String          @id @default(uuid())
  facilityId    String
  facility      ParkingFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  slotNumber    String          // e.g. A01, A02, B01
  floor         String          @default("G")
  section       String          @default("A")
  vehicleType   String          @default("FOUR_WHEELER")
  category      String          @default("REGULAR") // REGULAR, PREMIUM, DISABLED, EV, TWO_WHEELER
  priceModifier Float           @default(0.0)
  status        String          @default("AVAILABLE") // AVAILABLE, HELD, RESERVED, OCCUPIED, MAINTENANCE, BLOCKED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bookings      Booking[]
  holds         SlotHold[]

  @@unique([facilityId, slotNumber])
}

model SlotHold {
  id          String      @id @default(uuid())
  slotId      String
  slot        ParkingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdToken   String      @unique
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
}

model Booking {
  id              String          @id @default(uuid())
  bookingCode     String          @unique
  qrToken         String          @unique
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  facilityId      String
  facility        ParkingFacility @relation(fields: [facilityId], references: [id])
  slotId          String
  slot            ParkingSlot     @relation(fields: [slotId], references: [id])
  startTime       DateTime
  endTime         DateTime
  actualEntryTime DateTime?
  actualExitTime  DateTime?
  basePrice       Float
  taxAmount       Float
  platformFee     Float
  discountAmount  Float           @default(0.0)
  overstayFee     Float           @default(0.0)
  totalAmount     Float
  status          String          @default("CONFIRMED") // PENDING, PAYMENT_PENDING, CONFIRMED, UPCOMING, ACTIVE, COMPLETED, CANCELLED, EXPIRED, REFUNDED
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  payment         Payment?
  refund          Refund?
  review          Review?
  couponUsages    CouponUsage[]
  supportTickets  SupportTicket[]
}

model Payment {
  id            String    @id @default(uuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  orderId       String    @unique
  paymentId     String?
  signature     String?
  amount        Float
  paymentMethod String    @default("UPI") // UPI, CARD, NETBANKING, WALLET
  status        String    @default("SUCCESS") // CREATED, PENDING, SUCCESS, FAILED, REFUNDED
  createdAt     DateTime  @default(now())

  refunds       Refund[]
}

model Refund {
  id          String    @id @default(uuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id])
  refundId    String    @unique
  amount      Float
  reason      String?
  status      String    @default("PROCESSED") // PENDING, PROCESSED, FAILED
  processedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model Coupon {
  id              String        @id @default(uuid())
  code            String        @unique
  discountPercent Float?
  fixedDiscount   Float?
  maxDiscount     Float?
  minOrder        Float         @default(0.0)
  startDate       DateTime      @default(now())
  endDate         DateTime
  usageLimit      Int           @default(1000)
  perUserLimit    Int           @default(1)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())

  usages          CouponUsage[]
}

model CouponUsage {
  id             String    @id @default(uuid())
  couponId       String
  coupon         Coupon    @relation(fields: [couponId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id])
  discountAmount Float
  usedAt         DateTime  @default(now())
}

model Review {
  id                String          @id @default(uuid())
  bookingId         String          @unique
  booking           Booking         @relation(fields: [bookingId], references: [id])
  facilityId        String
  facility          ParkingFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  rating            Float           @default(5.0)
  cleanlinessRating Float?          @default(5.0)
  safetyRating      Float?          @default(5.0)
  serviceRating     Float?          @default(5.0)
  reviewText        String?
  ownerResponse     String?
  createdAt         DateTime        @default(now())
}

model Favorite {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId  String
  facility    ParkingFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([userId, facilityId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   @default("SYSTEM") // BOOKING, PAYMENT, PROMOTION, SYSTEM, PARKING, ACCOUNT
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  ticketCode  String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  category    String   @default("GENERAL") // BOOKING, PAYMENT, REFUND, PARKING, ACCOUNT, TECHNICAL
  subject     String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_FOR_USER, RESOLVED, CLOSED
  priority    String   @default("MEDIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  actorRole  String
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Payout {
  id                 String       @id @default(uuid())
  ownerId            String
  owner              ParkingOwner @relation(fields: [ownerId], references: [id])
  amount             Float
  commissionDeducted Float
  netAmount          Float
  status             String       @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  referenceNumber    String?
  processedAt        DateTime     @default(now())
  createdAt          DateTime     @default(now())
}
