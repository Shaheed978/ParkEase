# Environment Configuration for ParkEase

# App Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL or SQLite for quick local dev)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET=parkease_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Cache & Lock (Redis ready, fallback to in-memory)
REDIS_URL=redis://localhost:6379

# Map Integration
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
NEXT_PUBLIC_MAP_API_KEY=

# Payments (Razorpay Ready)
RAZORPAY_KEY_ID=rzp_test_parkease_mock_key
RAZORPAY_KEY_SECRET=rzp_test_parkease_mock_secret
PAYMENT_SIMULATION_MODE=true

# Storage & Email
STORAGE_BUCKET=parkease-assets
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525

# Platform Commission Default (%)
PLATFORM_COMMISSION_PERCENT=10.0
